{
  "uid": "iot-ml-capstone",
  "title": "IoT-ML Capstone (Hands-on 38)",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now+1d"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Temperature",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-iotlab"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iotlab"
          },
          "refId": "A",
          "query": "from(bucket: \"sensor_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"capstone_device_monitoring\" and r._field == \"temperature_c\")"
        }
      ]
    },
