    {
      "id": 7,
      "title": "Jumlah alert per jam",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-iotlab"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iotlab"
          },
          "refId": "A",
          "query": "from(bucket: \"sensor_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"capstone_alerts\" or (r._measurement == \"capstone_device_monitoring\" and (r._field == \"iforest_anomaly\" or r._field == \"threshold_alert\")))\n  |> filter(fn: (r) => r._field == \"iforest_anomaly\" or r._field == \"threshold_alert\" or r._field == \"alert_flag\")\n  |> aggregateWindow(every: 1h, fn: sum, createEmpty: false)"
        }
      ]
    },
